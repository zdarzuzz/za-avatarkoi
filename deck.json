[{"name": "01-oblozhka", "bg": "paper", "ops": [{"t": "img", "f": "23202c7e431b.jpg", "x": 0.0, "y": 0.0, "w": 1920.0, "h": 760.0, "n": "Обложка — иллюстрация", "b": null}, {"t": "text", "x": 104, "y": 650, "s": "Человек в твоих глазах", "size": 150, "w": 400, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Название"}, {"t": "text", "x": 104, "y": 870, "s": "Интерактивный манга-лонгрид о первом впечатлении", "size": 50, "w": 600, "c": "#000000", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Подзаголовок"}, {"t": "text", "x": 104, "y": 955, "s": "Дарья Зюзина", "size": 40, "w": 600, "c": "#292526", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Автор"}, {"t": "text", "x": 1816, "y": 962, "s": "zdarzuzz.github.io/za-avatarkoi", "size": 34, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "end", "i": false, "ls": 0, "n": "Ссылка на сайт"}]}, {"name": "02-vopros", "bg": "red", "ops": [{"t": "text", "x": 104, "y": 64, "s": "02", "size": 32, "w": 600, "c": "#FFE8E7", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Номер"}, {"t": "text", "x": 168, "y": 64, "s": "ВОПРОС ПРОЕКТА", "size": 30, "w": 600, "c": "#FFE8E7", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 3, "n": "Раздел"}, {"t": "img", "f": "6e7b1d207816.png", "x": 1180, "y": 0, "w": 740, "h": 1080, "n": "Скринтон", "b": null}, {"t": "text", "x": 104, "y": 200, "s": "Что мы узнаём о человеке из анкеты — и что добавляем сами?", "size": 84, "w": 400, "c": "#FFE8E7", "maxw": 900, "lh": 1.12, "a": "start", "i": false, "ls": 0, "n": "Вопрос"}, {"t": "text", "x": 104, "y": 532.24, "s": "Сначала читатель решает по короткой карточке. Потом видит один эпизод знакомства — и пересматривает впечатление.", "size": 44, "w": 600, "c": "#FFE8E7", "maxw": 860, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Пояснение"}, {"t": "img", "f": "88132f4c297d.jpg", "x": 1100.0, "y": 309.0, "w": 380.0, "h": 432.1, "n": "Анкета Сони", "b": null}, {"t": "img", "f": "12789b2c874c.jpg", "x": 1500.0, "y": 435.0, "w": 330.0, "h": 150.1, "n": "Кадр Сони", "b": null}, {"t": "text", "x": 1110, "y": 930, "s": "Анкета: «сначала молчу,\nпотом рассказываю ерунду»", "size": 32, "w": 600, "c": "#FFE8E7", "maxw": null, "lh": 1.2, "a": "start", "i": false, "ls": 0, "n": "Подпись анкеты"}, {"t": "text", "x": 1490, "y": 750, "s": "Поступок: утром на вокзале\nСоня приносит кофе", "size": 32, "w": 600, "c": "#FFE8E7", "maxw": null, "lh": 1.2, "a": "start", "i": false, "ls": 0, "n": "Подпись кадра"}]}, {"name": "03-dlya-kogo", "bg": "paper", "ops": [{"t": "text", "x": 104, "y": 64, "s": "03", "size": 32, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Номер"}, {"t": "text", "x": 168, "y": 64, "s": "ДЛЯ КОГО", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 3, "n": "Раздел"}, {"t": "text", "x": 104, "y": 190, "s": "Для тех, кто привык выбирать людей по профилям", "size": 84, "w": 400, "c": "#000000", "maxw": 900, "lh": 1.12, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 104, "y": 522.24, "s": "Знакомства, попутчики, сообщества и рекомендации — везде сначала видна карточка, а не человек.", "size": 44, "w": 600, "c": "#292526", "maxw": 840, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 104, "y": 727.24, "s": "Публикацию проходят самостоятельно — на компьютере или телефоне. Решения читателя становятся материалом: к ним вернутся в конце.", "size": 44, "w": 600, "c": "#292526", "maxw": 840, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "img", "f": "8f9e7eda461a.png", "x": 1100.0, "y": 219.2, "w": 330.0, "h": 681.6, "n": "Телефон — обложка", "b": null}, {"t": "img", "f": "8c07005ab0c5.png", "x": 1480.0, "y": 219.2, "w": 330.0, "h": 681.6, "n": "Телефон — анкета", "b": null}]}, {"name": "04-zachem-brauzer", "bg": "paper", "ops": [{"t": "text", "x": 104, "y": 64, "s": "04", "size": 32, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Номер"}, {"t": "text", "x": 168, "y": 64, "s": "ПОЧЕМУ ЭТО САЙТ", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 3, "n": "Раздел"}, {"t": "text", "x": 104, "y": 170, "s": "Выбор → раскрытие → пересмотр", "size": 84, "w": 400, "c": "#000000", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "img", "f": "b52f58c08f46.jpg", "x": 221.2, "y": 330.0, "w": 293.5, "h": 470.0, "n": "1  Выбор", "b": null}, {"t": "text", "x": 104.0, "y": 830, "s": "1  Выбор", "size": 44, "w": 700, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 104.0, "y": 895, "s": "Решение и причина фиксируются сразу, в самой анкете.", "size": 32, "w": 400, "c": "#292526", "maxw": 528.0, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "img", "f": "5c7b9ffa99da.jpg", "x": 764.8, "y": 330.0, "w": 390.3, "h": 470.0, "n": "2  Раскрытие", "b": null}, {"t": "text", "x": 696.0, "y": 830, "s": "2  Раскрытие", "size": 44, "w": 700, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 696.0, "y": 895, "s": "По прокрутке открывается эпизод знакомства.", "size": 32, "w": 400, "c": "#292526", "maxw": 528.0, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "img", "f": "1805febdd07d.jpg", "x": 1288.0, "y": 363.9, "w": 528.0, "h": 402.2, "n": "3  Пересмотр", "b": null}, {"t": "text", "x": 1288.0, "y": 830, "s": "3  Пересмотр", "size": 44, "w": 700, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 1288.0, "y": 895, "s": "Первый выбор стоит рядом с текущим — его можно изменить.", "size": 32, "w": 400, "c": "#292526", "maxw": 528.0, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}]}, {"name": "05-marshrut", "bg": "paper", "ops": [{"t": "text", "x": 104, "y": 64, "s": "05", "size": 32, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Номер"}, {"t": "text", "x": 168, "y": 64, "s": "МАРШРУТ ЧТЕНИЯ", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 3, "n": "Раздел"}, {"t": "img", "f": "8869f41210b6.jpg", "x": 104.0, "y": 150.0, "w": 398.0, "h": 223.9, "n": "Обложка", "b": "#C03740"}, {"t": "text", "x": 104.0, "y": 387.875, "s": "1  Обложка", "size": 34, "w": 600, "c": "#000000", "maxw": 398.0, "lh": 1.1, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 104.0, "y": 427.275, "s": "пауза", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": true, "ls": 0, "n": null}, {"t": "img", "f": "f1b9b45198e0.jpg", "x": 542.0, "y": 150.0, "w": 398.0, "h": 223.9, "n": "Билет", "b": "#C03740"}, {"t": "text", "x": 542.0, "y": 387.875, "s": "2  Билет", "size": 34, "w": 600, "c": "#000000", "maxw": 398.0, "lh": 1.1, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 542.0, "y": 427.275, "s": "вход", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": true, "ls": 0, "n": null}, {"t": "img", "f": "7d8710b46e25.jpg", "x": 980.0, "y": 150.0, "w": 398.0, "h": 223.9, "n": "Анкеты", "b": "#C03740"}, {"t": "text", "x": 980.0, "y": 387.875, "s": "3  Анкеты", "size": 34, "w": 600, "c": "#000000", "maxw": 398.0, "lh": 1.1, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 980.0, "y": 427.275, "s": "решения", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": true, "ls": 0, "n": null}, {"t": "img", "f": "33aa8317b215.jpg", "x": 1418.0, "y": 150.0, "w": 398.0, "h": 223.9, "n": "Уверенность", "b": "#C03740"}, {"t": "text", "x": 1418.0, "y": 387.875, "s": "4  Уверенность", "size": 34, "w": 600, "c": "#000000", "maxw": 398.0, "lh": 1.1, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "img", "f": "f3f7b0a93bc7.jpg", "x": 104.0, "y": 523.9, "w": 398.0, "h": 223.9, "n": "Манга", "b": "#C03740"}, {"t": "text", "x": 104.0, "y": 761.75, "s": "5  Манга", "size": 34, "w": 600, "c": "#000000", "maxw": 398.0, "lh": 1.1, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 104.0, "y": 801.15, "s": "перелом", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": true, "ls": 0, "n": null}, {"t": "img", "f": "a2ab90c2d329.jpg", "x": 542.0, "y": 601.9, "w": 398.0, "h": 67.8, "n": "«А что добавил ты?»", "b": "#C03740"}, {"t": "text", "x": 542.0, "y": 761.75, "s": "6  «А что добавил ты?»", "size": 34, "w": 600, "c": "#000000", "maxw": 398.0, "lh": 1.1, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 542.0, "y": 801.15, "s": "пауза", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": true, "ls": 0, "n": null}, {"t": "img", "f": "1183e322da96.jpg", "x": 980.0, "y": 523.9, "w": 398.0, "h": 223.9, "n": "Психологический разбор", "b": "#C03740"}, {"t": "text", "x": 980.0, "y": 761.75, "s": "7  Психологический разбор", "size": 34, "w": 600, "c": "#000000", "maxw": 398.0, "lh": 1.1, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 980.0, "y": 801.15, "s": "выход назад", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": true, "ls": 0, "n": null}, {"t": "img", "f": "bf07f84163d9.jpg", "x": 1418.0, "y": 523.9, "w": 398.0, "h": 223.9, "n": "«Что теперь ты видишь иначе?»", "b": "#C03740"}, {"t": "text", "x": 1418.0, "y": 761.75, "s": "8  «Что теперь ты видишь иначе?»", "size": 34, "w": 600, "c": "#000000", "maxw": 398.0, "lh": 1.1, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 1418.0, "y": 838.55, "s": "завершение", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": true, "ls": 0, "n": null}, {"t": "text", "x": 104, "y": 1000, "s": "Отдельные этапы: разбор открывается с начала, из итогов можно вернуться к истории. Финал — «Попробовать ещё раз».", "size": 32, "w": 400, "c": "#292526", "maxw": 1712, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}]}, {"name": "06-situatsii", "bg": "paper", "ops": [{"t": "text", "x": 104, "y": 64, "s": "06", "size": 32, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Номер"}, {"t": "text", "x": 168, "y": 64, "s": "СИТУАЦИИ ЗНАКОМСТВА", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 3, "n": "Раздел"}, {"t": "text", "x": 104, "y": 160, "s": "Один и тот же человек — в трёх обстоятельствах", "size": 72, "w": 400, "c": "#000000", "maxw": 1100, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "img", "f": "03d4dae20106.jpg", "x": 104.0, "y": 360, "w": 538.7, "h": 360, "n": "Школьная поездка", "b": null}, {"t": "text", "x": 104.0, "y": 750, "s": "Школьная поездка", "size": 44, "w": 700, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 104.0, "y": 815, "s": "Два дня в новом городе: видно, как человек планирует и уступает.", "size": 32, "w": 400, "c": "#292526", "maxw": 538.6666666666666, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "img", "f": "3af63026d03a.jpg", "x": 690.7, "y": 360, "w": 538.7, "h": 360, "n": "Поездка в приют", "b": null}, {"t": "text", "x": 690.6666666666666, "y": 750, "s": "Поездка в приют", "size": 44, "w": 700, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 690.6666666666666, "y": 815, "s": "Одна смена: забота, просьбы и границы.", "size": 32, "w": 400, "c": "#292526", "maxw": 538.6666666666666, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "img", "f": "47a78a49d1be.jpg", "x": 1277.3, "y": 360, "w": 538.7, "h": 360, "n": "Поход в кино", "b": null}, {"t": "text", "x": 1277.3333333333333, "y": 750, "s": "Поход в кино", "size": 44, "w": 700, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 1277.3333333333333, "y": 815, "s": "Вечер во дворе: общее дело, споры и паузы.", "size": 32, "w": 400, "c": "#292526", "maxw": 538.6666666666666, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 104, "y": 975, "s": "Билет выпадает случайно и не меняется до конца прохождения; при повторе — другой.", "size": 32, "w": 400, "c": "#292526", "maxw": 1712, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}]}, {"name": "07-ankety", "bg": "paper", "ops": [{"t": "text", "x": 104, "y": 64, "s": "07", "size": 32, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": "Номер"}, {"t": "text", "x": 168, "y": 64, "s": "АНКЕТЫ И ВЫБОР", "size": 30, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls": 3, "n": "Раздел"}, {"t": "img", "f": "3bed5885188b.jpg", "x": 104, "y": 150, "w": 1060, "h": 663, "n": "Активная анкета", "b": "#C03740"}, {"t": "img", "f": "41bf2ef61973.jpg", "x": 1313.0, "y": 150.0, "w": 414.1, "h": 663.0, "n": "Вопрос о причине", "b": null}, {"t": "text", "x": 104, "y": 840, "s": "Активная анкета: рядом — пустые рамки, следующий человек не раскрывается.", "size": 32, "w": 400, "c": "#292526", "maxw": 1060, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 1220, "y": 840, "s": "Первый ответ — точка сравнения", "size": 40, "w": 700, "c": "#C03740", "maxw": 600, "lh": 1.25, "a": "start", "i": false, "ls": 0, "n": null}, {"t": "text", "x": 1220, "y": 898.0, "s": "После решения анкета спрашивает о причине и сама перелистывается.", "size": 32, "w": 400, "c": "#292526", "maxw": 600, "lh": 1.22, "a": "start", "i": false, "ls": 0, "n": null}]}, {"name": "08-manga", "bg": "paper", "ops": [{"t": "text", "x": 104, "y": 64, "s": "08", "size": 32, "w": 600, "c": "#C03740", "maxw": null, "lh": 1.25, "a": "start", "i": false, "ls"